# Normalise all text files to LF in the repository (cross-platform safe).
# Working copies on Windows keep their native endings; the repo stays LF.
* text=auto eol=lf

# Explicit text types (so Git never guesses wrong)
*.tf        text eol=lf
*.hcl       text eol=lf
*.tfvars    text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sh        text eol=lf
*.txt       text eol=lf
*.ndjson    text eol=lf
*.drawio    text eol=lf

# Binary assets — never munge line endings or attempt diffs
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
